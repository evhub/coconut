def py311_test() -> bool:
    """Performs Python-3.11-specific tests."""
    multi_err = ExceptionGroup("herp", [ValueError("a"), ValueError("b")])
    got_err = None
    try:
        raise multi_err
    except* ValueError as err:
        got_err = err
    assert repr(got_err) == repr(multi_err), (got_err, multi_err)
    got_errs: list[BaseExceptionGroup] = []
    try:
        raise ExceptionGroup("derp", [TypeError("a"), ValueError("b")])
    except *TypeError as err:
        got_errs.append(err)
    except * ValueError as err:
        got_errs.append(err)
    assert [type(e.exceptions[0]) for e in got_errs] == [TypeError, ValueError]
    assert [1, 2, 3][x := 1] == 2
    assert x == 1

    # *args: *Ts (PEP 646) and **kwargs: **TD (PEP 692)
    import typing
    Ts = typing.TypeVarTuple("Ts")
    def variadic(*args: *Ts) -> tuple[*Ts] = args
    assert variadic(1, "a") == (1, "a")
    class KW(typing.TypedDict):
        a: int
    def kwfunc(**kwargs: **KW) -> int = kwargs["a"]
    assert kwfunc(a=1) == 1
    return True
