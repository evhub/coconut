def py314_test() -> bool:
    """Performs Python-3.14-specific tests."""
    # Test basic t-string
    name = "World"
    template = t"Hello {name}!"
    assert type(template).__name__ == "Template"
    assert template.strings == ("Hello ", "!")
    assert len(template.interpolations) == 1
    assert template.interpolations[0].value == "World"

    # Test t-string with Coconut syntax
    template2 = t"Result: {[1,2,3] |> len}"
    assert template2.strings == ("Result: ", "")
    assert template2.interpolations[0].value == 3

    # Test t-string with = specifier (debug syntax)
    x = 42
    template3 = t"{x=}"
    assert template3.interpolations[0].value == 42

    # Test raw t-string
    template4 = rt"\n{x}"
    assert template4.strings == ("\\n", "")
    assert template4.interpolations[0].value == 42

    # Test multiple interpolations
    a, b = 1, 2
    template5 = t"{a} + {b} = {a + b}"
    assert template5.strings == ("", " + ", " = ", "")
    assert len(template5.interpolations) == 3
    assert template5.interpolations[0].value == 1
    assert template5.interpolations[1].value == 2
    assert template5.interpolations[2].value == 3

    # constrained type parameters must stay constraints, not become extra type parameters
    def constrained[T: (int, str)](x: T) -> T = x
    assert constrained.__type_params__[0].__constraints__ == (int, str)  # type: ignore
    assert len(constrained.__type_params__) == 1
    # a single constraint stays a constraint (rather than becoming a bound)
    class SingleConstraint[T: (int,)]:
        pass
    assert SingleConstraint.__type_params__[0].__constraints__ == (int,)  # type: ignore
    assert SingleConstraint.__type_params__[0].__bound__ is None

    # PEP 696 type parameter defaults
    class DefaultBox[T = int, **P = [int]]:
        pass
    assert [p.__default__ for p in DefaultBox.__type_params__] == [int, [int]]
    class DefaultVariadic[*Ts = *tuple[str, ...]]:
        pass
    assert DefaultVariadic.__type_params__[0].__default__ == next(iter(tuple[str, ...]))  # type: ignore
    def default_first[T: (int, str) = int](x: T) -> T = x
    assert default_first.__type_params__[0].__default__ is int

    # the = specifier defaults to repr
    tx = "hi"
    assert t"{tx=}".interpolations[0].conversion == "r"

    return True
